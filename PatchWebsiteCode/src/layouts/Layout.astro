---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
  title = 'Patch',
  description = "Patch is Ireland’s community for ambitious young technologists, scientists, and entrepreneurs."
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://joinpatch.org');
---

<!doctype html>
<!-- Built by Tim Farrelly, Patch alum: https://timfarrelly.com -->
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Primary meta description -->
		<meta name="description" content={description} />

		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalURL.href} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL.href} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<!-- JSON-LD structured data -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Organization",
			"name": "Patch",
			"url": "https://joinpatch.org",
			"description": description,
			"sameAs": [
				"https://twitter.com/joinpatch"
			]
		})} />
	</head>
	<body>
		<div class="main-container">
			<slot />
		</div>
		<script>
			console.log('Built by Tim Farrelly, Patch alum: https://timfarrelly.com');
		</script>
	</body>
</html>
